# --- Секреты: НИКОГДА не попадают в репозиторий ---
.env
.env.local
*.key
*.pem
# Ключ Google service account. ВНИМАНИЕ: в .gitignore комментарий работает
# только с начала строки — дописать "# пояснение" в конец правила нельзя,
# иначе оно молча перестанет срабатывать.
credentials.json
service_account*.json
*-service-account.json

# --- Виртуальное окружение ---
.venv/
venv/

# --- Артефакты Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Данные приложения (локальная БД, логи) ---
data/
*.db
*.sqlite3
*.log

# --- IDE / ОС ---
.vscode/
.idea/
Thumbs.db
desktop.ini
