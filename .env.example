# ШАБЛОН настроек. Скопируй в .env и заполни реальными значениями.
#   PowerShell:  Copy-Item .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore), а этот шаблон — попадает,
# чтобы любой человек (или ты через полгода) видел, какие переменные нужны.

# --- Общие ---
APP_ENV=dev              # dev | prod
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Хранилище (Фаза 1) ---
DB_PATH=data/leadhub.db

# --- Веб-сервер (Фаза 1) ---
HOST=127.0.0.1
PORT=8000

# Общий секрет для защиты вебхука: отправитель обязан прислать его в заголовке
# X-Webhook-Secret. Только ASCII (он едет в HTTP-заголовке).
# Пустое значение = проверка выключена — работает ТОЛЬКО в dev:
# при APP_ENV=prod пустой секрет не даст приложению запуститься.
WEBHOOK_SECRET=

# Окно дедупликации заявок без внешнего id, в днях. Внутри окна одинаковое
# содержимое — дубль (двойной клик), в следующем окне — новая заявка.
DEDUP_WINDOW_DAYS=1

# --- Воркер и ретраи (Фаза 2) ---
WORKER_POLL_INTERVAL=2.0        # как часто заглядывать в очередь, сек
WORKER_BATCH_SIZE=10            # сколько задач брать за заход
RETRY_MAX_ATTEMPTS=5            # попыток на шаг, потом — в dead letter
RETRY_BASE_DELAY_SECONDS=2.0    # первая задержка; дальше 4, 8, 16...
RETRY_MAX_DELAY_SECONDS=300.0   # потолок задержки

# --- Уведомления в Telegram (Фаза 3) ---
# Токен: написать @BotFather -> /newbot -> имя -> @username бота.
# Chat ID: НАПИСАТЬ БОТУ ЛЮБОЕ СООБЩЕНИЕ (бот не может начать диалог первым),
#   затем открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять
#   result[0].message.chat.id
# Оставь пусто — шаг уведомлений просто не включится.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Sheets (Фаза 2) ---
# Ключ сервис-аккаунта: Google Cloud Console -> Credentials -> Service account
# -> Keys -> Add key -> JSON. Файл положить в корень проекта (он в .gitignore!).
# Таблицу нужно ОТДЕЛЬНО расшарить на email сервис-аккаунта с правами Редактора —
# сам по себе он не видит ничего.
# Оставь пусто — шаг записи в Sheets просто не включится, остальное будет работать.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Лиды

# Часовой пояс для дат, которые видит владелец (внутри система живёт в UTC)
DISPLAY_TIMEZONE=Europe/Moscow

# --- LLM (Фаза 4) ---
# fake — заглушка: система работает без ключей, сети и расходов.
# openai_compatible — настоящий API (Gemini, OpenAI, OpenRouter, Ollama...).
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=

# Один и тот же провайдер подходит к разным сервисам — меняется только адрес:
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai/   (ключ: aistudio.google.com/apikey)
#   OpenRouter https://openrouter.ai/api/v1/
#   OpenAI     https://api.openai.com/v1/
#   Ollama     http://localhost:11434/v1/                                 (локально, ключ любой)
# Claude тоже отвечает по этому протоколу, НО молча игнорирует response_format
# и prompt caching — для него правильнее отдельный провайдер на нативном SDK.
LLM_BASE_URL=

LLM_TEMPERATURE=0.2        # низкая: нужна воспроизводимая классификация
LLM_MAX_TOKENS=700         # потолок ответа: и от разговорчивости, и от счёта
LLM_MAX_PARSE_ATTEMPTS=2   # сколько раз просить модель исправить формат
LLM_JSON_MODE=true         # просить провайдера гарантировать валидный JSON

# Сколько секунд доставка (таблица, Telegram) ждёт оценку AI, прежде чем
# отправить карточку без неё. Верхняя граница задержки уведомления.
AI_WAIT_SECONDS=45
